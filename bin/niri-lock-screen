#!/usr/bin/env bash
set -euo pipefail

if command -v flock >/dev/null 2>&1; then
  exec 9>"${XDG_RUNTIME_DIR:-/tmp}/niri-lock-screen.lock"
  flock -n 9 || exit 0
fi

if command -v hyprlock >/dev/null 2>&1; then
  # Per-host overrides (pam.module etc.) live in an untracked local config
  # that sources the shared one; see docs/hyprlock-lockscreen.md.
  hyprlock_local="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprlock.local.conf"
  if [[ -f "$hyprlock_local" ]]; then
    exec hyprlock --config "$hyprlock_local" --immediate-render --no-fade-in
  fi
  exec hyprlock --immediate-render --no-fade-in
fi

if command -v noctalia >/dev/null 2>&1; then
  exec noctalia msg session lock
fi

if command -v loginctl >/dev/null 2>&1; then
  exec loginctl lock-session
fi

echo "niri-lock-screen: no supported lock command found" >&2
exit 1
